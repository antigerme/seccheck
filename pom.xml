<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.security</groupId>
    <artifactId>dpck-web</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakartaee.version>10.0.0</jakartaee.version>
        <!-- ISO 8601 UTC para Build-Time no MANIFEST.MF -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
    </properties>

    <dependencies>
        <!-- Jakarta EE API for Servlets -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>${jakartaee.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- JSON processing -->
        <!-- [SEC] Sempre use versao mais recente do jackson-databind (historico de CVEs graves) -->
        <!-- Cap em <2.22.0: jackson-databind 2.22.0 foi publicado mas o jackson-core 2.22.0   -->
        <!-- ainda nao saiu no Maven Central (split release "in flight"). Quando sair, e seguro-->
        <!-- elevar/remover o teto. Maven resolve para 2.21.x enquanto isso.                   -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>[2.17.0,2.22.0)</version>
        </dependency>
        <!-- OWASP Dependency-Check Core -->
        <!-- Range aberto: o Maven sempre vai buscar a versao mais recente disponivel -->
        <!-- no Maven Central a cada 'mvn clean package'. Assim o WAR sai sempre -->
        <!-- com o motor de analise mais atualizado sem precisar editar este arquivo. -->
        <dependency>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-core</artifactId>
            <version>[10.0.0,)</version>
        </dependency>
        <!-- SLF4J API: usada diretamente pelo nosso codigo (LogUtils delega para ela) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>[2.0.0,)</version>
        </dependency>
        <!-- Implementacao simples do SLF4J, exigida pelo dependency-check em runtime -->
        <!-- [SEC] Versao mais recente do SLF4J para cobrir CVEs historicos -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>[2.0.0,)</version>
        </dependency>

        <!-- ============================================================== -->
        <!-- Overrides de versao para deps transitivas com CVE conhecida.   -->
        <!-- Maven aplica "nearest wins": declarar aqui sobrescreve a versao-->
        <!-- que o dependency-check-core traria por padrao.                 -->
        <!-- Manter como range aberto pra acompanhar futuras correcoes.     -->
        <!-- ============================================================== -->

        <!-- gson 2.9.0 (transitiva de dependency-check-core) flagada pelo  -->
        <!-- OSSINDEX em CVE-2025-53864 (atribuicao via sigstore-java).     -->
        <!-- 2.11+ resolve a flag e e drop-in compativel.                   -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>[2.11.0,)</version>
        </dependency>

        <!-- httpclient5-cache 5.6 (transitiva de dependency-check-core)    -->
        <!-- vulneravel a CVE-2026-40542 (CVSS 7.3, SCRAM-SHA-256 sem       -->
        <!-- mutual auth). Fixed em 5.6.1+. O httpclient5 "core" ja sai em  -->
        <!-- 5.6.1 pela transitiva, so o "-cache" estava atrasado.          -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5-cache</artifactId>
            <version>[5.6.1,)</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>ROOT</finalName>
        <plugins>
            <!-- Extrai metadados do .git e expoe como propriedades do Maven (git.commit.id, etc) -->
            <!-- Em S2I, o builder image clona o .git no diretorio de build, entao isso funciona  -->
            <!-- sem alteracao na BuildConfig. failOnNoGitDirectory=false torna o build resiliente -->
            <!-- a "binary builds" (oc start-build a partir de um diretorio sem .git).            -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <!-- Plugins do Maven nao resolvem ranges. Pinamos versao estavel recente. -->
                <version>9.0.1</version>
                <executions>
                    <execution>
                        <id>get-git-info</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <dateFormat>yyyy-MM-dd'T'HH:mm:ss'Z'</dateFormat>
                    <dateFormatTimeZone>UTC</dateFormatTimeZone>
                    <includeOnlyProperties>
                        <includeOnlyProperty>git.commit.id$</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.id.abbrev</includeOnlyProperty>
                        <includeOnlyProperty>git.commit.time</includeOnlyProperty>
                        <includeOnlyProperty>git.branch</includeOnlyProperty>
                        <includeOnlyProperty>git.dirty</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <archive>
                        <manifestEntries>
                            <!-- Identidade do build: lida em runtime pelo BuildInfo + /api/version -->
                            <Implementation-Title>${project.artifactId}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                            <Build-Jdk>${java.version}</Build-Jdk>
                            <!-- Git: vazio quando .git ausente (binary build), nunca quebra -->
                            <Git-Commit>${git.commit.id}</Git-Commit>
                            <Git-Commit-Short>${git.commit.id.abbrev}</Git-Commit-Short>
                            <Git-Commit-Time>${git.commit.time}</Git-Commit-Time>
                            <Git-Branch>${git.branch}</Git-Branch>
                            <Git-Dirty>${git.dirty}</Git-Dirty>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!-- [SEC] Auto-escaneamento: a propria aplicacao varre seu WAR final em busca de CVEs. -->
            <!-- Rode com:  mvn verify -Pself-scan                                                 -->
            <!-- Saida em:  target/dependency-check-report.html                                    -->
        </plugins>
    </build>

    <profiles>
        <!-- Self-scan: invoca a classe br.com.security.tools.SelfScan via exec-maven-plugin -->
        <!-- usando a biblioteca dependency-check-core ja declarada como dependencia com    -->
        <!-- range aberto [10.0.0,). Assim o scan SEMPRE roda na versao mais recente do     -->
        <!-- motor, sem precisar pinar o dependency-check-maven plugin (que Maven 3.9 nao   -->
        <!-- permite mais via LATEST/RELEASE).                                              -->
        <!--                                                                                -->
        <!-- Uso: mvn verify -Pself-scan                                                    -->
        <!--      mvn verify -Pself-scan -Dselfscan.failOnAnyCve=true                       -->
        <profile>
            <id>self-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>self-scan</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>br.com.security.tools.SelfScan</mainClass>
                                    <classpathScope>compile</classpathScope>
                                    <arguments>
                                        <argument>${project.build.directory}/${project.build.finalName}.war</argument>
                                        <argument>${project.build.directory}</argument>
                                    </arguments>
                                    <systemProperties>
                                        <systemProperty>
                                            <key>selfscan.failOnAnyCve</key>
                                            <value>${selfscan.failOnAnyCve}</value>
                                        </systemProperty>
                                    </systemProperties>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
